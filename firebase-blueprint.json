{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing credits and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "credits": { "type": "integer", "description": "Remaining conversion credits" },
        "isUnlimited": { "type": "boolean", "description": "Whether the user has unlimited credits" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email", "credits", "isUnlimited", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credit management."
    }
  }
}
