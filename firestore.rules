rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'titaniumfact97@gmail.com';
    }

    function isValidUser(data) {
      return data.uid is string && 
             data.uid.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.credits is number &&
             data.isUnlimited is bool &&
             data.role in ['user', 'admin'] &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && 
                      request.auth.uid == userId &&
                      isValidUser(request.resource.data) &&
                      request.resource.data.uid == request.auth.uid &&
                      (request.resource.data.email == 'titaniumfact97@gmail.com' ? 
                        (request.resource.data.role == 'admin' && request.resource.data.credits == 999999 && request.resource.data.isUnlimited == true) : 
                        (request.resource.data.role == 'user' && request.resource.data.credits == 10 && request.resource.data.isUnlimited == false)) &&
                      request.resource.data.createdAt == request.time;

      allow update: if (isAdmin()) || (
        isOwner(userId) && 
        isValidUser(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isUnlimited == resource.data.isUnlimited &&
        request.resource.data.createdAt == resource.data.createdAt &&
        // Action: Deduct 1 credit
        request.resource.data.credits == resource.data.credits - 1
      );

      allow delete: if false; // Profiles cannot be deleted
    }
  }
}
